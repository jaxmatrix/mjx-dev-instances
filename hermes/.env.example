# Hermes instance configuration.
# Copy to .env and fill in:  cp .env.example .env
#
# Agent credentials (OPENROUTER_API_KEY and the other provider keys) do NOT go
# here — they live in agent.env, which the compose file passes through with
# `env_file:`. See agent.env.example.

# Where the mjx-hermes-agent source lives. This is the docker build context:
# the image is built from source rather than pulled, and pointing it at the
# working tree is the whole point of this instance — rebuild after pulling
# upstream and you are testing the merge.
HERMES_SOURCE_DIR=/home/xm-max/Documents/Projects/mjx-hermes-agent

# Dashboard login (the bundled dashboard_auth/basic provider).
#
# These are NOT optional. The dashboard binds 0.0.0.0 so Caddy can reach it,
# and the auth gate engages on every non-loopback bind — start_server refuses
# to bind at all when no auth provider is registered. There is no --insecure
# escape hatch any more; it is accepted and ignored.
#
# This is also the username and password you type into the Universal client
# when connecting to https://hermes.dev.internal as a remote backend.
HERMES_BASIC_AUTH_USERNAME=admin
HERMES_BASIC_AUTH_PASSWORD=hermesdev

# HMAC key used to sign dashboard session tokens. Generate with:
#   openssl rand -base64 32
# Leaving this empty makes the provider mint a random key per process, which
# silently invalidates every saved session on each restart.
HERMES_BASIC_AUTH_SECRET=change-me-before-first-start

# Host user that owns ./data, so files the container writes stay writable.
#   id -u   /   id -g
HERMES_UID=1000
HERMES_GID=1000

# Public URL, including the scheme. Must match how the browser and the
# Universal client actually reach the dashboard.
HERMES_PUBLIC_URL=https://hermes.dev.internal

# Loopback host port for the dashboard. Not 9119 — allr/ already binds that.
HERMES_DASHBOARD_HOST_PORT=9120

# Which upstream proxies uvicorn trusts for X-Forwarded-* headers. Caddy comes
# from a devnet address, not 127.0.0.1, so the default would drop its
# X-Forwarded-Proto and strip Secure from the session cookies.
HERMES_FORWARDED_ALLOW_IPS=*

# Must match the root .env
DEV_NETWORK=devnet
