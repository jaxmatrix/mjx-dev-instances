# Allr instance configuration.
# Copy to .env and fill in:  cp .env.example .env

# Where the allr-agent source lives. This is the docker build context: the
# image is built from source rather than pulled, because no published image
# exists for this fork.
ALLR_SOURCE_DIR=/home/xm-max/Documents/Projects/allr-agent

# Dashboard login (the bundled dashboard_auth/basic provider).
#
# These are NOT optional. The dashboard binds 0.0.0.0 so Caddy can reach it,
# and the auth gate engages on every non-loopback bind — start_server refuses
# to bind at all when no auth provider is registered. There is no --insecure
# escape hatch any more; it is accepted and ignored.
#
# This is also the username and password you type into the Allr Universal
# client when connecting to https://allr.dev.internal as a remote backend.
ALLR_BASIC_AUTH_USERNAME=admin
ALLR_BASIC_AUTH_PASSWORD=allrdev

# HMAC key used to sign dashboard session tokens. Generate with:
#   openssl rand -base64 32
# Leaving this empty makes the provider mint a random key per process, which
# silently invalidates every saved session on each restart.
ALLR_BASIC_AUTH_SECRET=change-me-before-first-start

# Host user that owns ./data, so files the container writes stay writable.
#   id -u   /   id -g
ALLR_UID=1000
ALLR_GID=1000

# Public URL, including the scheme. Must match how the browser and the
# Universal client actually reach the dashboard.
ALLR_PUBLIC_URL=https://allr.dev.internal

# Loopback host port for the dashboard.
ALLR_DASHBOARD_PORT=9119

# Which upstream proxies uvicorn trusts for X-Forwarded-* headers. Caddy comes
# from a devnet address, not 127.0.0.1, so the default would drop its
# X-Forwarded-Proto and strip Secure from the session cookies.
ALLR_FORWARDED_ALLOW_IPS=*

# ---------------------------------------------------------------------------
# Login mode  (dashboard.login / ALLR_DASHBOARD_LOGIN)
# ---------------------------------------------------------------------------
#
#   internal  the dashboard renders its own /login — provider chooser and,
#             when basic auth is configured, the password form
#   external  sign-in is handed to the IdP: /login and unauthenticated page
#             loads both 302 to Dex
#   (empty)   unset — falls through to `dashboard.login` in data/config.yaml,
#             which is how you test that env beats config
#
# `external` only changes anything when the OIDC provider is the ONLY one
# registered. It deliberately still renders the page when a password provider
# is present, because that is the way back into a deployment whose IdP is
# down. So to watch the redirect actually fire, blank ALLR_BASIC_AUTH_USERNAME
# below as well.
ALLR_LOGIN_MODE=internal

# ---------------------------------------------------------------------------
# Dex — the OIDC provider that makes `external` observable
# ---------------------------------------------------------------------------
#
# The issuer must be reachable at this exact string from BOTH the browser and
# the agent container; ./dex/dex.yaml explains how that is arranged and why it
# is *.localhost rather than *.dev.internal. Change it only alongside the
# `issuer:` line in dex/dex.yaml — they must agree.
ALLR_OIDC_ISSUER=http://auth.localhost:5556
ALLR_OIDC_CLIENT_ID=allr-dashboard

# Loopback host port for Dex. Must match the port in ALLR_OIDC_ISSUER.
DEX_PORT=5556
DEX_VERSION=v2.45.1

# The Dex dev account you log in with. The password hash lives in
# dex/dex.yaml (bcrypt); regenerate it with:
#   htpasswd -bnBC 10 "" '<password>' | cut -d: -f2
# Default account: dev@allr.test / allrdev

# Must match the root .env
DEV_NETWORK=devnet
