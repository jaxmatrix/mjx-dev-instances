# Shared datastore credentials.  cp .env.example .env
#
# POSTGRES_PASSWORD is the superuser password. Per-instance roles and databases
# are created from it by ./dev (see `./dev db create`), so instances never need
# the superuser password themselves.
#
# Generate one with:  openssl rand -base64 24

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-before-first-start

# Host-side ports (loopback only). Change if something else already owns them.
POSTGRES_PORT=5432
VALKEY_PORT=6379

VALKEY_MAXMEMORY=256mb

# Must match the root .env
DEV_NETWORK=devnet
