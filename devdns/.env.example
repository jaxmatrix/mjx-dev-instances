# Internal dev DNS + TLS.  cp .env.example .env

DEV_DOMAIN=dev.internal

# The address *.dev.internal resolves to. Normally this peer's NetBird IP so
# other peers reach the services; 127.0.0.1 for a local-only setup.
#   netbird status -d | grep -i ip
DEV_HOST_IP=127.0.0.1

# Upstream resolvers for everything outside DEV_DOMAIN. Named explicitly rather
# than inherited from /etc/resolv.conf, which would loop once this host uses
# CoreDNS as its own resolver. Point one at your router if you rely on it for
# LAN names.
DNS_UPSTREAM_1=1.1.1.1
DNS_UPSTREAM_2=9.9.9.9

# Bind addresses. 0.0.0.0 so LAN hosts and NetBird peers can both reach these.
# Narrow to a specific interface IP if you want to restrict access — note that
# binding to the NetBird IP requires the wt0 interface to already exist.
DNS_BIND_IP=0.0.0.0
HTTP_BIND_IP=0.0.0.0

DNS_PORT=53
HTTP_PORT=80
HTTPS_PORT=443

COREDNS_VERSION=1.12.0
CADDY_VERSION=2-alpine

# Must match the root .env
DEV_NETWORK=devnet
