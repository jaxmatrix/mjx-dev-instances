# CoreDNS for the internal dev domain.
#
# {$VAR} is CoreDNS's own environment-variable substitution, populated from
# devdns/.env by docker-compose.

{$DEV_DOMAIN}:53 {
    # Per-name overrides. Anything listed here wins; everything else falls
    # through to the wildcard template below.
    hosts /etc/coredns/hosts.dev {
        fallthrough
    }

    # Wildcard: every name in this zone resolves to the dev host.
    #
    # No `match` regex is needed — the server block above already scopes this to
    # {$DEV_DOMAIN}, and template's match defaults to `.*`. Leaving it out also
    # avoids embedding the domain in a regex where its dots would be unescaped
    # wildcards.
    #
    # This wildcard is what makes new services need no DNS change at all: the
    # name already resolves, and Caddy routes it by Host header.
    template IN A {
        answer "{{ .Name }} 60 IN A {$DEV_HOST_IP}"
    }

    # Answer AAAA with an empty NOERROR rather than NXDOMAIN, so clients on
    # dual-stack networks stop looking for an IPv6 address instead of stalling
    # while the A lookup already has an answer.
    template IN AAAA {
        rcode NOERROR
    }

    log
    errors
}

# Everything else is forwarded upstream. This block is why the server can be
# registered in NetBird as a *primary* nameserver: it is a complete resolver,
# not merely an authority for one domain.
#
# Upstreams are named explicitly rather than inherited from /etc/resolv.conf,
# which would loop once this host resolves through CoreDNS itself.
.:53 {
    forward . {$DNS_UPSTREAM_1} {$DNS_UPSTREAM_2}
    cache 30
    log
    errors
}
