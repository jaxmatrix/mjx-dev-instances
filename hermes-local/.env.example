# hermes-local configuration.
# Copy to .env and fill in:  cp .env.example .env
#
# Unlike every other instance, this one runs nothing in Docker: `./dev up
# hermes-local` installs the checkout below as the host's `hermes` command.

# The checkout to install. It is installed editable, so source edits and
# `git pull`s take effect on the next `hermes` invocation. Re-run
# `./dev up hermes-local` when dependencies (uv.lock) change.
HERMES_SOURCE_DIR=/home/xm-max/Documents/Projects/mjx-hermes-agent

# Where the hermes, hermes-agent and hermes-acp wrappers are written. Must come
# before any other hermes on PATH.
HERMES_BIN_DIR=/home/xm-max/.local/bin

# Data directory. Leave unset for hermes's own default, ~/.hermes — the same
# data the stock install used. Set it to give the fork a data dir of its own;
# the wrappers then export it.
#HERMES_HOME=/home/xm-max/.hermes
