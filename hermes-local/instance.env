# Metadata read by ./dev.
# KIND=host: nothing runs in Docker. `./dev up hermes-local` runs install.sh,
# which installs the mjx-hermes-agent checkout as this machine's `hermes`
# command; there is no container to stop, restart or tail.
KIND=host
NEEDS_SHARED=false
DESCRIPTION="mjx-hermes-agent installed on the host as the hermes command"
