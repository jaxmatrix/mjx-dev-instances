# Metadata read by ./dev. DB_NAME/DB_USER cause ./dev to create the role and
# database in the shared Postgres (idempotently) before starting this instance.
NEEDS_SHARED=true
DB_NAME=penpot
DB_USER=penpot
DB_PASSWORD_VAR=PENPOT_DATABASE_PASSWORD
DESCRIPTION="Penpot design tool"
URL=https://penpot.dev.internal
