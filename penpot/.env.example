# Penpot instance configuration.  cp .env.example .env

PENPOT_VERSION=2.17

# Master key from which session and invitation keys are derived. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=

# Credentials for the `penpot` role in the shared Postgres. ./dev creates the
# role and database with exactly this password on first `./dev up penpot`, so
# set it before the first start. Generate with:  openssl rand -base64 24
PENPOT_DATABASE_NAME=penpot
PENPOT_DATABASE_USERNAME=penpot
PENPOT_DATABASE_PASSWORD=

# Valkey logical database index in the shared cache.
PENPOT_REDIS_DB=1

# Must match how the browser reaches Penpot, or asset URLs and OAuth redirects
# will be generated wrong. Use http://127.0.0.1:9001 only if you also add
# `disable-secure-session-cookies` to PENPOT_FLAGS in docker-compose.yml.
PENPOT_PUBLIC_URI=https://penpot.dev.internal

PENPOT_PORT=9001
PENPOT_MAILCATCH_PORT=1080

# Must match the root .env
DEV_NETWORK=devnet
