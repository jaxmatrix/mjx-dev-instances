# Jaeger instance configuration.  cp .env.example .env
#
# No secrets — Jaeger all-in-one is open on the private NetBird mesh.

# Pin to a release tag for reproducible restarts.
# https://github.com/jaegertracing/jaeger/releases
JAEGER_VERSION=2.20.0

JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318

# Must match the root .env
DEV_NETWORK=devnet
