# OpenViking instance configuration.  cp .env.example .env
#
# These are substituted into data/ov.conf at load time via ${VAR} references,
# so the config file itself stays committable.

# Google AI Studio API key — drives BOTH the Gemini embedding model and the
# LiteLLM VLM route below. Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Root API key clients authenticate with (X-API-Key header).
# Generate one with:  openssl rand -hex 32
OPENVIKING_ROOT_API_KEY=

# VLM used for L0/L1 semantic summaries during ingestion, as a LiteLLM route.
# Because it goes through LiteLLM, this can be repointed at another provider by
# changing this one value — e.g.
#   anthropic/claude-sonnet-5
#   openai/gpt-5
#   ollama/llama3.1          (also set an api_base in ov.conf)
# Verify the id is live before first ingest:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$GOOGLE_API_KEY" \
#     | grep -o '"name": "models/[^"]*"'
OV_VLM_MODEL=gemini/gemini-2.5-flash

# Pin to a release tag instead of latest if you want reproducible restarts.
OPENVIKING_VERSION=latest

OPENVIKING_PORT=1933
OPENVIKING_PUBLIC_BASE_URL=https://openviking.dev.internal

# Must match the root .env
DEV_NETWORK=devnet
