# Root configuration shared by ./dev and every instance.
# Copy to .env and fill in:  cp .env.example .env

# Internal dev domain served by devdns. Everything under *.dev.internal resolves
# to DEV_HOST_IP and is routed by Caddy on the Host header.
DEV_DOMAIN=dev.internal

# The IP that *.dev.internal resolves to. This is the address other NetBird peers
# use to reach this machine, so it should normally be this peer's NetBird IP.
#
#   netbird up                     # if the daemon reports NeedsLogin
#   netbird status -d | grep -i ip # read the NetBird IP (100.x.x.x)
#
# Use 127.0.0.1 for a purely local setup with no other peers.
DEV_HOST_IP=127.0.0.1

# Shared Docker network joined by every instance. Created by ./dev, not by compose.
DEV_NETWORK=devnet
